  "@type": "sc:Dataset",
  "@id": "https://huggingface.co/datasets/moss-vector-714/GeoFidelity-Bench",
  "conformsTo": [
    "http://mlcommons.org/croissant/1.1",
    "http://mlcommons.org/croissant/RAI/1.0"
  ],
  "name": "GeoFidelity-Bench",
  "version": "3.1.0",
  "description": "Geographic-fidelity benchmark with 112 named street blocks in 25 cities and 23 countries, 7563 block-image assignments covering 7433 distinct Mapillary images, and 16128 images generated by six text-to-image models. Includes prompt controls and the original geographic-fidelity score records.",
  "url": "https://huggingface.co/datasets/moss-vector-714/GeoFidelity-Bench",
  "dateCreated": "2026-04-29",
  "datePublished": "2026-05-05",
  "dateModified": "2026-09-25",
  "inLanguage": [
    "en"
  ],
  "isAccessibleForFree": true,
  "license": [
    "https://creativecommons.org/licenses/by-sa/4.0/",
    "https://opendatacommons.org/licenses/odbl/1-0/"
  ],
  "creator": [
    {
      "@type": "sc:Person",
      "name": "Kaizhen Tan",
      "email": "kt3275@nyu.edu"
    }
  ],
  "publisher": [
    {
      "@type": "sc:Person",
      "name": "Kaizhen Tan",
      "email": "kt3275@nyu.edu"
    }
  ],
  "keywords": [
    "text-to-image generation",
    "street-view imagery",
    "geographic fidelity",
    "location-conditioned generation",
    "benchmark",
    "Mapillary",
    "OpenStreetMap"
  ],
  "citeAs": "@inproceedings{tan2026geofidelity,\n  title={GeoFidelity-Bench: Evaluating Block-Conditioned Geographic Fidelity in Text-to-Image Street-View Generation},\n  author={Tan, Kaizhen},\n  booktitle={Advances in Neural Information Processing Systems},\n  year={2026}\n}",
  "rai:dataCollection": "Named OSM ways were selected in 25 cities and queried for public Mapillary imagery. Five automatic stages check daylight and camera type, OSM-buffer membership, urban scene content, semantic ratios, and image quality. Retained blocks have at least 25 images. Six generators produce four images per target and condition; L0 files were reused from an existing city-only pool.",
  "rai:dataCollectionType": [
    "Public Mapillary imagery",
    "OpenStreetMap geographic metadata",
    "Synthetic images from six text-to-image models"
  ],
  "rai:dataCollectionMissingData": "Coverage follows Mapillary activity and OSM naming density. Unavailable negative relations and unrecorded L0 seeds remain blank. The current reference metadata do not contain sequence identifiers.",
  "rai:dataPreprocessingProtocol": "Automatic filters produce the original 112-block reference index. Four real images per block serve as held-out queries. The prompt-ablation and control evaluation sessions are archived separately. Each gallery retains its four indexed negative relations, including repeated entries when present. Source images can have assignments to multiple nearby blocks. JPEG pixels and original score records are preserved.",
  "rai:dataAnnotationProtocol": "Geographic labels derive from OSM and source metadata. SigLIP supplies urban-scene scores; Mask2Former supplies semantic pixel ratios; DINOv2 supplies visual embeddings. No person identity or demographic labels are added.",
  "rai:dataImputationProtocol": "Unrecorded fields are left missing. In particular, original L0 generation seeds are not reconstructed from filenames.",
  "rai:machineAnnotationTools": [
    "SigLIP SO400M",
    "Mask2Former Swin-L trained on Mapillary Vistas",
    "DINOv2 ViT-B/14",
    "CLIP ViT-B/32",
    "SegFormer-B5 trained on Cityscapes"
  ],
  "rai:dataLimitations": "The benchmark measures visual agreement with local reference panels, rather than factual reconstruction of a street or event. It samples daytime perspective street imagery in 112 blocks and has uneven geographic coverage. The text-prompt experiments do not evaluate map- or coordinate-native input systems. Person identification, surveillance, private-address inference, and evidentiary use are outside the intended scope.",
  "rai:dataBiases": "Mapillary contributor activity and OSM naming density determine geographic coverage. Daylight, camera, semantic-content, and image-quality filters shape the retained distribution. Informal settlements, peri-urban areas, and sparsely mapped regions may be underrepresented. Camera hardware and capture dates vary. Semantic predictions may differ in accuracy across urban forms and regions.",
  "rai:personalSensitiveInformation": "Public street-level images and coordinates can reveal location context, storefronts, and vehicles. Images retain Mapillary's existing privacy processing, including blurred faces and plates where applied by the platform. The dataset adds no person, face, license-plate, demographic, or private-address labels.",
  "rai:dataUseCases": "The intended construct is visual agreement between generated street views and images from a requested named street block. Held-out real-query comparisons, geographically related negative panels, and prompt-name substitutions assess this construct. Supported uses are matched model comparisons and prompt-conditioning studies. Validity has not been established for person identification, factual scene reconstruction, fairness certification, or safety certification.",
  "rai:dataSocialImpact": "The dataset can help identify geographically inaccurate or stereotyped generated streetscapes. Generated images may reinforce place stereotypes or mislead viewers if represented as photographs of real events. Reported scores describe visual comparisons against sampled reference panels. The benchmark does not provide evidence that a generated image depicts an actual event or a person's location.",
  "rai:hasSyntheticData": true,
  "rai:dataReleaseMaintenancePlan": "Kaizhen Tan maintains the public Hugging Face release at kt3275@nyu.edu. Version 3.1.0 aligns public indices with the original 112-block experiments, documents seed provenance, and adds the code archive. Original images and evaluation records are retained. Earlier data and results remain available through repository history.",
  "prov:wasDerivedFrom": [
    {
      "@id": "https://www.mapillary.com/"
    },
    {
      "@id": "https://www.openstreetmap.org/"
    },
    {
      "@id": "https://huggingface.co/datasets/moss-vector-714/GeoFidelity-Bench/resolve/main/metadata/generated_images.csv"
    }
  ],
  "prov:wasGeneratedBy": [
    {
      "@type": "prov:Activity",
      "@id": "#collection-and-curation",
      "description": "Kaizhen Tan collected public Mapillary images around named OSM ways. Automatic daylight, geometry, scene-content, semantic, and image-quality filters produced the original indexed reference assignments. Code, thresholds, and retained image indices are publicly released."
    },
    {
      "@type": "prov:Activity",
      "@id": "#synthetic-generation",
      "description": "SDXL, SD 3.5 Large, FLUX.1-dev, FLUX.1-schnell, PixArt-Sigma, and HunyuanDiT produced street-view images under the indexed prompts. The image index contains recorded seeds for L1, L2, and the controls; reused L0 seeds are unrecorded. Four images are retained per model, condition, and target."
    },
    {
      "@type": "prov:Activity",
      "@id": "#evaluation",
      "description": "Original evaluation records contain DINOv2 visual metrics, semantic-ratio GAAS, and individual-image retrieval. Prompt and control comparisons use 5,000 matched model-block pair bootstrap resamples. The additional CLIP analysis resamples blocks with all models together. The released CSVs distinguish the original prompt-ablation and control sessions."
    }
  ],
