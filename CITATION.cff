cff-version: 1.2.0
message: "If you use GeoFidelity-Bench, please cite the paper below."
title: "GeoFidelity-Bench"
abstract: >-
  Code for GeoFidelity-Bench, a benchmark for evaluating whether
  text-to-image street-view images match a target location at the level
  of named street blocks. It covers 112 blocks in 25 cities, each paired
  with a panel of real Mapillary images.
type: software
authors:
  - family-names: Tan
    given-names: Kaizhen
    email: kt3275@nyu.edu
    affiliation: "Carnegie Mellon University; New York University; NYU Shanghai"
repository-code: "https://github.com/tantansir/geofidelity-bench-release"
url: "https://tantansir.github.io/geofidelity-bench-release/"
license: MIT
keywords:
  - text-to-image generation
  - street-view imagery
  - geographic fidelity
  - benchmark
  - Mapillary
  - OpenStreetMap
preferred-citation:
  type: conference-paper
  title: "GeoFidelity-Bench: Evaluating Block-Conditioned Geographic Fidelity in Text-to-Image Street-View Generation"
  authors:
    - family-names: Tan
      given-names: Kaizhen
  collection-title: "Advances in Neural Information Processing Systems (NeurIPS), Track on Evaluations and Datasets"
  conference:
    name: "40th Conference on Neural Information Processing Systems (NeurIPS 2026)"
  year: 2026
